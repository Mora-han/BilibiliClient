<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS App 的 Info.plist（Xcode 工程用）。

  内容与 scripts/build_ios_app.sh 里用 python 生成的那份保持一致：那条线服务
  「打未签名 IPA」，这条线服务「Xcode 连真机调试」，两份都改的时候要同步。

  刻意不写 CFBundleIcons：图标交给 actool 从 assets/Bilibiliclient.icon 生成
  （见 project.yml 的 ASSETCATALOG_COMPILER_APPICON_NAME）。而 build_ios_app.sh
  是手工拼 bundle，没有 asset catalog 编译步骤，所以它必须把 CFBundleIcons 写进 plist。
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Bilibili Client</string>
	<key>CFBundleName</key>
	<string>BilibiliClient</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>26.0</string>
	<!-- 1=iPhone、2=iPad -->
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<!-- 空启动屏：没有它会跑在兼容模式（iPhone 应用放大模式）下 -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- iPad 全方向支持，才能用 Split View / Stage Manager / 台前调度 -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- HLSProxy 用 http://127.0.0.1 起本地代理转发 HLS，必须豁免 ATS -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 下载产物写在 Documents 下：缺这两个键，mp4 在「文件」App 里看不到 -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 后台继续播放 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
